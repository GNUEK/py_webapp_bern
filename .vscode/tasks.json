{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "uv: sync environment",
            "type": "shell",
            "command": "uv sync --locked --all-groups",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": true
            }
        }
    ]
}