# Vorlage für die lokale Datei .env (kopieren nach .env und Werte ausfüllen).
# .env steht in .gitignore und kommt nie ins Repository.
# Auf Azure dieselben Namen unter Konfiguration -> App-Settings eintragen.
# Lokal sind alle Werte optional.

# Signiert das Session-Cookie. Auf Azure einen zufälligen Wert setzen:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Ort der SQLite-Datei (lokal Standard: instance/velo.db)
# DATABASE_PATH=/home/data/velo.db

# Strava (nur für K4)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
